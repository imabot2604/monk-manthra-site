{% comment %} Full cart page — the drawer's non-JS counterpart. {% endcomment %}
<section class="section section--tight">
  <div class="wrap">
    <div class="section__head">
      <p class="label">Your order</p>
      <hr class="gold-rule">
      <h1 class="display">{% if cart.item_count == 0 %}Nothing in the order yet.{% else %}Your order.{% endif %}</h1>
    </div>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="table-scroll">
          <table class="dose-table">
            <thead><tr>
              <th scope="col">Product</th><th scope="col">Quantity</th><th scope="col">Total</th>
            </tr></thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr>
                  <td class="state">{{ item.product.title }}</td>
                  <td class="num">
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                           aria-label="Quantity for {{ item.product.title }}" style="width:4rem">
                  </td>
                  <td class="num">{{ item.final_line_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="product__buy" style="margin-top:28px">
          <button type="submit" name="update" class="btn btn--quiet">Update</button>
          <button type="submit" name="checkout" class="btn">Checkout</button>
          <span class="price">{{ cart.total_price | money }}</span>
        </div>
      </form>
    {%- else -%}
      <p><a class="textlink" href="{{ routes.all_products_collection_url }}">See the range</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}
