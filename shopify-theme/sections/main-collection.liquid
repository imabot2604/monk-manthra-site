{% comment %} The range / any collection listing. {% endcomment %}
<section class="section section--tight">
  <div class="wrap">
    <div class="section__head">
      <p class="label">{{ collection.title }}</p>
      <hr class="gold-rule">
      <h1 class="display">{{ section.settings.heading | default: collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    <div class="range">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>Nothing in this collection yet.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collection", "settings": [ { "type": "text", "id": "heading", "label": "Heading override" } ] }
{% endschema %}
