{% comment %}
  The six-card grid. Reuses snippets/product-card.liquid so the card markup
  exists in exactly one place, the way build.py's card() does.
{% endcomment %}
<section class="section{% if section.settings.paper %} section--paper{% endif %}">
  <div class="wrap">
    {%- if section.settings.label != blank or section.settings.heading != blank -%}
    <div class="section__head">
      {%- if section.settings.label != blank -%}<p class="label">{{ section.settings.label }}</p>{%- endif -%}
      <hr class="gold-rule">
      {%- if section.settings.heading != blank -%}<h2 class="display">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="lede">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- endif -%}
    <div class="range">
      {%- for product in section.settings.collection.products -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Range grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Named for the state. Verified by the ingredient." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "You shop by feeling and check by ingredient — never the other way round. Six formulas, one word each." },
    { "type": "checkbox", "id": "paper", "label": "White ground", "default": true }
  ],
  "presets": [{ "name": "Range grid" }]
}
{% endschema %}
