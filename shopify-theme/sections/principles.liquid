{% comment %}
  The three rules from build.py's page_index(), as a section so the one-page
  store still says what the brand is for.
{% endcomment %}
<section class="section anchor" id="{{ section.settings.anchor | default: 'idea' }}">
  <div class="wrap">
    <div class="section__head">
      <p class="label">{{ section.settings.label }}</p>
      <hr class="gold-rule">
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="principles">
      {%- for block in section.blocks -%}
        <div class="principle" {{ block.shopify_attributes }}>
          <h3 class="heading">{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Principles",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Principles" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A manthra is one word, repeated, until it changes something." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "That is also how a body works — a small dose, a walk, a meal, a night of proper sleep, taken daily, until the effect compounds." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "idea" }
  ],
  "blocks": [
    { "type": "principle", "name": "Principle", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "body", "label": "Body" }
    ]}
  ],
  "presets": [{ "name": "Principles" }]
}
{% endschema %}
