{% comment %}
  Mirrors build.py's page_index() hero. The mark draws once on load —
  Section Eleven: "the mark draws once on load, then never animates again."
{% endcomment %}
<section class="hero on-purple">
  <div class="wrap">
    {% render 'mark', size: 104, draw: true, rings_lock: 3 %}
    <h1 class="display">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {%- if section.settings.cta_url != blank -%}
      <a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <div class="hero__note"><p class="data">{{ section.settings.note }}</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seven supplements. One habit." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Single-ingredient formulas at doses you can check. Made to be taken every day, not talked about every day." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the range" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Mono note", "default": "7 FORMULAS · 0 PROPRIETARY BLENDS" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
