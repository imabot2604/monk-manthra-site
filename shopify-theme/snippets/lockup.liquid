{% comment %}
  The wordmark + mark, as a link. Mirrors build.py's `header()` lockup
  exactly, including the guide-mandated .15em wordmark tracking (set once in
  assets/theme.css, not here).

  No colour parameter, matching mark.liquid — the footer's own on-purple
  class on <footer> is what recolours everything inside it, this snippet
  included. Never pass a variant into the render call; wrap it instead.

  Usage:
    {% render 'lockup' %}                                       header, 32px, three rings
    {% render 'lockup', size: 44, rings_lock: 3, disc: false %}  footer, three rings, no disc

  rings_lock defaults to 3. The header deliberately overrides Section Two's
  reduction rule (which prescribes one ring at <=32px) at the brand owner's
  direction; the footer matches it at 3 so the two marks are identical.
{% endcomment %}
{%- liquid
  assign l_size = size | default: 32
  assign l_rings = rings_lock | default: 3
  # nil (not passed) must still mean true, so only an explicit false disables it
  assign l_disc = true
  if disc == false
    assign l_disc = false
  endif
-%}
<a class="lockup{% if stacked %} lockup--stacked{% endif %}" href="{{ routes.root_url }}" aria-label="monk manthra — home">
  {%- if l_disc -%}
    <span class="lockup__disc on-purple">{% render 'mark', size: l_size, rings_lock: l_rings %}</span>
  {%- else -%}
    {% render 'mark', size: l_size, rings_lock: l_rings %}
  {%- endif -%}
  <span class="lockup__type">
    <span class="wordmark">monk manthra</span>
    {%- unless stacked -%}
      <span class="lockup__sub nav__hide-sm">Nutrition</span>
    {%- endunless -%}
  </span>
</a>
