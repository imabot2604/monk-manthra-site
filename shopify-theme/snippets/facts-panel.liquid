{% comment %}
  Section Nine — Label anatomy. "A legal document, not a design surface."
  Black on white, Plex Mono, heavy rules intact, never tinted purple —
  same rules as .facts in theme.css, now filled from real product data
  instead of build.py's dict. See METAFIELDS.md for the full field list.

  Usage: {% render 'facts-panel', product: product %}
{% endcomment %}
{%- liquid
  assign m = product.metafields.monkmanthra
  assign servings = m.count.value | split: ' ' | first
-%}
<div class="facts">
  <h3>Supplement Facts</h3>
  <hr class="facts__hr">
  <div class="row-head"><span>Serving size</span><span>{{ m.serving.value }}</span></div>
  <div class="row-head"><span>Servings per container</span><span>{{ servings }}</span></div>
  <hr class="facts__hr facts__hr--heavy">
  <div class="row-head"><span></span><span>Amount / serving</span></div>
  <hr class="facts__hr">
  <table>
    {%- for row in m.facts.value -%}
      <tr>
        <td>{% if row.indent %}&nbsp;&nbsp;{% endif %}{{ row.name }}</td>
        <td>{{ row.value }}</td>
      </tr>
    {%- endfor -%}
  </table>
  <hr class="facts__hr facts__hr--mid">
  <div class="facts__foot">
    <p>Other ingredients: {{ m.other_ingredients.value }}</p>
    {%- if m.allergens.value -%}<p>{{ m.allergens.value }}</p>{%- endif -%}
    <p>Directions: {{ m.directions.value }}</p>
    <p>Not for use during pregnancy. Keep out of reach of children.</p>
    {%- if m.lot_code.value or m.best_before.value -%}
      <p>
        {%- if m.lot_code.value -%}Lot {{ m.lot_code.value }}{%- endif -%}
        {%- if m.lot_code.value and m.best_before.value -%} · {%- endif -%}
        {%- if m.best_before.value -%}best before end {{ m.best_before.value }}{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>
