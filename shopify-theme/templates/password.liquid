{% comment %}
  Shown to every visitor when the shop is password protected
  (Online Store -> Preferences -> Restrict access with a password).

  Same front door as the homepage, plus the entry form. The form is required:
  without it nobody who has been given the password can actually get in. It
  is kept quiet and below the fold of attention rather than removed.
{% endcomment %}
{% render 'gate' %}

<div class="gate__entry">
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="gate__error">{{ form.errors.messages.form }}</p>
    {%- endif -%}
    <label class="visually-hidden" for="pw">Password</label>
    <input type="password" name="password" id="pw" autocomplete="current-password" placeholder="Password">
    <button type="submit" class="btn">Enter</button>
  {%- endform -%}
</div>
