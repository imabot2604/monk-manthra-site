<section class="section section--tight">
  <div class="wrap">
    <div class="section__head">
      <p class="label">Search</p><hr class="gold-rule">
      <h1 class="display">{% if search.performed %}{{ search.results_count }} results{% else %}Search{% endif %}</h1>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" aria-label="Search">
      <button type="submit" class="btn">Search</button>
    </form>
    {%- if search.performed -%}
      <div class="range" style="margin-top:36px">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
