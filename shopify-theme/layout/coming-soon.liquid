{% comment %}
  A layout with no chrome at all: no header, no nav, no footer, no cart
  drawer. The theme layout is still there for every other page; this one
  exists so the front door can be the mark and two words and nothing else.
{% endcomment %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }}</title>
<meta name="description" content="{{ shop.name }} is not open yet.">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,200;9..144,300&family=Karla:wght@300;500&display=swap">
{{ 'theme.css' | asset_url | stylesheet_tag }}
<link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
<meta name="theme-color" content="#3A1F5C">
<style>
  /* Deep purple ground, everything centred on one screen. The mark keeps its
     clear space: one seed diameter, same rule as every other surface. */
  /* The gate covers the viewport, but overscroll on iOS reveals the body
     behind it. Paint the body too so a rubber-band pull stays purple. */
  html, body { background: var(--deep-purple, #3A1F5C); }
  .gate {
    min-height: 100dvh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 28px;
    background: var(--deep-purple, #3A1F5C);
    padding: 40px 20px;
    text-align: center;
  }
  .gate .wordmark { font-size: clamp(1.25rem, 4vw, 1.75rem); }
  .gate__soon {
    font-family: var(--display, "Fraunces", serif);
    font-weight: 200;
    font-size: clamp(2rem, 7vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--half-white, #F4F1EC);
    margin: 0;
  }
</style>
{{ content_for_header }}
</head>
<body class="on-purple">
{{ content_for_layout }}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
